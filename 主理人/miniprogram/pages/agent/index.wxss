/* 我的团队：只有本页独有的两处（阶段筛选条 / 学员行右列）在这里，其余一律用 app.wxss 的原语 */

.stage-tabs {
  gap: 12rpx;
  overflow-x: auto;
  padding: 4rpx 4rpx 12rpx;
}

.stage-tab {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--paper);
  border: 2rpx solid var(--line-soft);
  font-size: var(--fs-meta);
  color: var(--ink-600);
}

.stage-tab--on {
  background: var(--ink-900);
  border-color: var(--ink-900);
  color: var(--ink-900);
}

/* 学员行右列：状态标签在上、时间在下，右对齐，避免与左侧班级名挤在一行 */
.stu-right {
  flex-shrink: 0;
  margin-left: 16rpx;
  text-align: right;
}

.plan-note {
  padding: 18rpx 8rpx 40rpx;
}
