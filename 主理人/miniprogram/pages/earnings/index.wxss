/* 我的收益。.hero / .hero-inner / .hero-title / .hero-k 的基座在 app.wxss（首页同款）。 */

/* 余额：这一页的主角，货币符号与数字分开排，符号不跟着放大 */
.amt-wrap { display: flex; align-items: baseline; gap: 6rpx; margin: 26rpx 0 8rpx; }
.amt-cur { font-size: 34rpx; font-weight: 600; color: var(--ink-700); }
.amt {
  font-size: 76rpx; font-weight: 650; color: var(--ink-900);
  letter-spacing: -2rpx; line-height: 1.05;
}
.hero-note {
  margin-top: 26rpx; padding-top: 22rpx;
  border-top: 1rpx solid rgba(247, 246, 244, 0.12);
}
.hero-note-t { font-size: var(--fs-micro); color: var(--ink-600); line-height: 1.6; }

.withdraw-wrap { margin: 30rpx var(--gutter) 30rpx; }
.withdraw-hint { margin-top: 12rpx; text-align: center; }

.wd-row { gap: 20rpx; }
.foot-note { margin: 0 var(--gutter); }

/* ─── 提现表单 ────────────────────────────── */
.form-balance {
  margin-top: 30rpx; padding: 24rpx;
  border-radius: var(--r-ctl);
  background: var(--sunk); border: 1rpx solid var(--line);
}
.form-balance-k { font-size: var(--fs-micro); color: var(--ink-600); }
.form-balance-v { font-size: 44rpx; font-weight: 650; color: var(--ink-900); }
.form-hint { margin-top: 10rpx; min-height: 30rpx; }
.form-hint-text { font-size: var(--fs-micro); color: var(--ink-600); }
.form-hint-text--error { color: var(--danger); }
.method-picker {
  margin-top: 14rpx; padding: 22rpx 26rpx;
  border-radius: var(--r-ctl);
  background: var(--sunk); border: 1rpx solid var(--line);
}
