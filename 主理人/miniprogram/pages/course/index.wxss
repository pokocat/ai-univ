/* 课程详情 / 回放页版式。 */
.cs-card { padding: 0; overflow: hidden; }
.cs-thumb {
  position: relative; height: 350rpx;
  display: flex; flex-direction: column; justify-content: flex-end;
  background: var(--grad-thumb);
}
.cs-badge { position: absolute; top: 21rpx; left: 21rpx; }
.cs-play {
  position: absolute; top: 42%; left: 50%; transform: translate(-50%, -50%);
  width: 101rpx; height: 101rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: rgba(109, 40, 217, 0.35); border: 3rpx solid rgba(168, 85, 247, 0.5);
}
.cs-cap { position: relative; z-index: 1; padding: 24rpx 28rpx; }
.cs-title { display: block; font-size: 33rpx; font-weight: 700; color: var(--ink-900); }
.cs-meta { display: block; margin-top: 10rpx; font-size: var(--fs-meta); color: var(--ink-700); }

.vstat {
  display: grid; grid-template-columns: 1fr 1fr 1fr;
  padding: 21rpx 10rpx; margin: 0 18rpx 21rpx;
  border-radius: var(--r-box);
  background: rgba(255, 252, 246, 0.8); border: 1rpx solid var(--line);
}
.vstat-i { display: flex; align-items: center; gap: 12rpx; justify-content: center; position: relative; }
.vstat-i + .vstat-i::before {
  content: ""; position: absolute; left: 0; top: 4rpx; bottom: 4rpx; width: 1rpx; background: var(--track);
}
.vs-t { display: block; font-size: var(--fs-meta); color: var(--ink-900); font-weight: 600; }
.vs-d { display: block; margin-top: 4rpx; font-size: var(--fs-micro); color: var(--ink-600); }

.chap-row {
  display: flex; align-items: center; gap: 19rpx;
  padding: 19rpx 18rpx; border-radius: var(--r-box); margin-bottom: 10rpx;
  background: var(--sunk); border: 1rpx solid transparent;
}
.chap-row--cur { background: var(--sunk-3); border-color: var(--line-signal); }
.chap-ico {
  width: 63rpx; height: 63rpx; flex: 0 0 63rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--sunk-3); border: 1rpx solid var(--line-brand);
}
.chap-t { display: block; font-size: var(--fs-h4); color: var(--ink-900); }
.play-circle, .dl-circle {
  width: 49rpx; height: 49rpx; flex: 0 0 49rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  border: 3rpx solid var(--line-signal); box-sizing: border-box;
}
.mat-tile {
  display: flex; align-items: center; gap: 18rpx; padding: 21rpx;
  border-radius: var(--r-box); background: var(--sunk); border: 1rpx solid var(--line);
}
.mat-t { display: block; font-size: var(--fs-sec); font-weight: 700; color: var(--ink-900); }
.block { display: block; }
