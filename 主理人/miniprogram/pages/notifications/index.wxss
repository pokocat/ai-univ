/* 消息与公告页版式。 */

.ann-hero { padding: 24rpx; }
.ann-hero-t { display: block; font-size: 35rpx; font-weight: 700; color: var(--ink-900); line-height: 1.3; }

.chip {
  font-size: var(--fs-tiny); color: var(--ink-700);
  padding: 7rpx 18rpx; border-radius: var(--r-chip);
  background: rgba(124, 58, 237, 0.05); border: 1rpx solid var(--line);
}
.chip--on { color: var(--signal-800); background: var(--sunk-3); border-color: var(--line-signal); }

.ann-row {
  display: flex; gap: 21rpx; align-items: flex-start;
  padding: 19rpx 0; border-top: 1rpx solid var(--line-soft);
}
.ann-row:first-of-type { border-top: none; }
.ann-t { font-size: var(--fs-h4); font-weight: 700; color: var(--ink-900); }
.msg-t { font-size: var(--fs-body); font-weight: 700; color: var(--ink-900); }
.block { display: block; }

.sub-banner { display: flex; align-items: center; gap: 18rpx; padding: 24rpx; }
.sub-t { display: block; font-size: var(--fs-h4); font-weight: 700; color: var(--on-signal); }
.sub-d { display: block; font-size: var(--fs-tiny); color: var(--on-signal-2); margin-top: 5rpx; }
.sub-btn {
  flex-shrink: 0; display: flex; align-items: center; gap: 8rpx;
  height: 58rpx; padding: 0 24rpx; border-radius: var(--r-pill);
  background: var(--on-signal-wash);
  color: var(--on-signal); font-size: var(--fs-sec); font-weight: 700;
}
