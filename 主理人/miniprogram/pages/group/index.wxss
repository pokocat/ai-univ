/* 班级社群页版式。共享原语在 app.wxss。 */

.class-hero { padding: 24rpx 24rpx 28rpx; overflow: hidden; }
.class-name {
  font-size: 49rpx; font-weight: 700;
  max-width: 380rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.class-count { display: block; font-size: 35rpx; font-weight: 700; color: var(--ink-900); margin-top: 4rpx; }
.mini-t { display: block; font-size: var(--fs-sec); font-weight: 700; color: var(--ink-900); }
.mini-d { display: block; font-size: var(--fs-tiny); color: var(--ink-600); margin-top: 2rpx; }

/* 两个并排大动作 */
.big-action {
  position: relative; border-radius: var(--r-card); padding: 28rpx 24rpx;
  min-height: 160rpx; display: flex; flex-direction: column; gap: 18rpx;
  box-sizing: border-box;
}
.big-action--grad {
  background: var(--grad-primary-d);
  border: 1rpx solid var(--line-signal);
  box-shadow: var(--sh-signal-sm);
}
.big-action--ghost {
  background: rgba(255, 247, 236, 0.9);
  border: 1rpx solid rgba(247, 182, 92, 0.4);
}
.ba-t { display: block; font-size: 30rpx; font-weight: 700; color: var(--ink-900); }
.ba-d { display: block; font-size: var(--fs-tiny); color: var(--ink-700); margin-top: 5rpx; }
.ba-t--on { color: var(--on-signal); }
.ba-d--on { color: var(--on-signal-2); }

/* 成员名单：横向滚动，不换行——换行会让卡片高度随人数跳动 */
.roster { display: flex; gap: 24rpx; overflow-x: auto; padding-bottom: 8rpx; }
.roster-i { flex: 0 0 auto; width: 96rpx; text-align: center; }
.roster-n {
  display: block; margin-top: 9rpx; font-size: var(--fs-tiny); color: var(--ink-900);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.me-pill {
  display: inline-block; margin-top: 5rpx;
  font-size: var(--fs-micro); color: var(--signal-600);
  padding: 2rpx 12rpx; border-radius: 9rpx;
  background: rgba(124, 58, 237, 0.12); border: 1rpx solid var(--line-brand);
}

/* 任务行 */
.task-t { display: block; font-size: var(--fs-body); font-weight: 600; color: var(--ink-900); }
.task-st { font-size: var(--fs-meta); font-weight: 700; }
.block { display: block; }

/* 活动 */
.act-thumb {
  position: relative; flex: 0 0 175rpx; height: 147rpx; border-radius: 18rpx;
  padding: 18rpx; box-sizing: border-box;
  display: flex; align-items: flex-end;
  background: var(--grad-thumb); border: 1rpx solid var(--line-strong);
}
.act-badge { position: absolute; left: 10rpx; top: 10rpx; }
.act-cover { font-size: var(--fs-meta); font-weight: 700; color: var(--signal-800); line-height: 1.3; }
.act-t { display: block; font-size: var(--fs-h4); font-weight: 700; color: var(--ink-900); }
.act-side { flex: 0 0 150rpx; }
.act-cd { display: block; font-size: var(--fs-sec); font-weight: 700; color: var(--ink-900); margin: 4rpx 0 12rpx; }
