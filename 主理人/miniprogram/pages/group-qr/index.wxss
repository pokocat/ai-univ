/* 入群页版式。 */
.gq-hero { padding: 28rpx; overflow: hidden; }
.gq-title { font-size: 47rpx; font-weight: 700; }
.gq-sec { display: block; text-align: center; font-size: var(--fs-body); font-weight: 700; color: var(--signal-600); letter-spacing: 4rpx; }
.gain-t { display: block; margin-top: 10rpx; font-size: var(--fs-sec); font-weight: 700; color: var(--ink-900); }
.gain-d { display: block; margin-top: 5rpx; font-size: var(--fs-micro); color: var(--ink-600); line-height: 1.4; }
.block { display: block; }
.join-cell { padding: 14rpx 0; }
