/* 服务工单页版式。 */
.tk-hero { padding: 24rpx 28rpx 28rpx; overflow: hidden; }
.tk-title { font-size: 45rpx; font-weight: 700; margin: 12rpx 0 10rpx; }
.type-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14rpx; }
.pick-t { font-size: var(--fs-tiny); text-align: center; }
.tk-t { font-size: var(--fs-h4); font-weight: 700; color: var(--ink-900); }
.block { display: block; }
.cta--busy { opacity: 0.72; }
