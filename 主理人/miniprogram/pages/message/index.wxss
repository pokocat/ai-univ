/* 公告详情页版式。 */
.msg-hero { padding: 28rpx; overflow: hidden; }
.msg-title { display: block; margin-top: 6rpx; font-size: 42rpx; font-weight: 700; color: var(--ink-900); line-height: 1.3; }
.viewed-chip {
  display: inline-flex; align-items: center; margin-top: 21rpx; padding: 10rpx 21rpx;
  border-radius: var(--r-pill);
  background: rgba(124, 58, 237, 0.05); border: 1rpx solid var(--line);
}
/* 正文保留服务端的换行：公告是运营手写的多段文字，压成一段会读不下去 */
.msg-body { display: block; font-size: 27rpx; color: var(--ink-800); line-height: 1.85; white-space: pre-line; }
.block { display: block; }
