/* 服务评价页版式。 */
.rv-title { font-size: 56rpx; letter-spacing: 2rpx; }
.rv-teacher { gap: 21rpx; padding-bottom: 21rpx; border-bottom: 1rpx solid var(--line-soft); }
.rv-info-v { display: block; margin-top: 9rpx; font-size: var(--fs-meta); font-weight: 600; color: var(--ink-900); }
.rv-stars { display: flex; justify-content: center; gap: 21rpx; }
.rv-star { padding: 8rpx; }
.rv-label { font-size: var(--fs-sec); font-weight: 700; color: var(--pulse-600); }
.block { display: block; }
.cta--busy { opacity: 0.72; }
