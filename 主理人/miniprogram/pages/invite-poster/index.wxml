<view class="screen screen--bar">
  <view class="ambience" />
  <view class="layer">
    <ui-subhead title="邀请海报" home="/pages/invite/index" />

    <ui-errbar wx:if="{{err}}" msg="{{err}}" retrying="{{load}}" bind:retry="load" />
    <view wx:if="{{loading}}" class="card card-pad"><view class="skeleton skeleton-block" /></view>

    <block wx:else>
      <!-- 海报本体：canvas 绘制，可保存到相册 -->
      <view class="card poster-wrap">
        <canvas
          type="2d"
          id="poster"
          class="poster-canvas"
          style="width:{{cw}}px;height:{{ch}}px;"
        ></canvas>
        <view wx:if="{{!drawn}}" class="poster-mask">
          <view class="skeleton" style="width:100%;height:100%;border-radius:24rpx;" />
        </view>
      </view>

      <!-- 邀请规则：三条都是真实规则，不是宣传语 -->
      <view class="card card-pad gap">
        <view wx:for="{{rules}}" wx:key="title" class="row-item">
          <view class="row-ico row-ico--lg"><ui-icon name="{{item.icon}}" size="{{38}}" color="signal" /></view>
          <view class="f-1">
            <text class="rule-t">{{item.title}}</text>
            <text class="t-tiny mt-6 block">{{item.desc}}</text>
          </view>
        </view>
      </view>

      <view class="box box--sunk gap">
        <view class="f" style="gap:12rpx;">
          <ui-icon name="info" size="{{28}}" color="signal" />
          <text class="t-sec fw-600">关于海报</text>
        </view>
        <text class="t-tiny mt-6 block">
          海报在本机绘制，包含你的邀请码与小程序码。小程序码未生成时海报仍可保存，
          好友可以手动输入邀请码——不会给你一张扫不出来的图。
        </text>
      </view>
    </block>
  </view>

  <view class="action-bar">
    <view class="action-row">
      <view class="cta cta--primary" bind:tap="savePoster">
        <ui-icon name="download" size="{{32}}" color="on-signal" /><text>保存海报</text>
      </view>
      <button class="cta cta--ghost" open-type="share">
        <ui-icon name="wechat" size="{{30}}" color="ok" /><text>分享给好友</text>
      </button>
    </view>
  </view>
</view>
