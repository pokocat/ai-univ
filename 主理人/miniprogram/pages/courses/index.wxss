/* 课程与直播。间距/字重工具类在 app.wxss，本页只写自己的东西。 */

.course-cell {
  position: relative;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
  transition: opacity 180ms ease;
}
.course-cell:last-child { border-bottom: none; }
.course-cell:active { opacity: 0.6; }

/* 直播中：左侧朱砂竖标。整行换底色会让「正在发生」和「已结束」抢同一层注意力 */
.course-cell--live::before {
  content: "";
  position: absolute; left: -32rpx; top: 26rpx; bottom: 26rpx;
  width: 5rpx; border-radius: 0 3rpx 3rpx 0;
  background: var(--signal-600);
}

.course-row { gap: 22rpx; align-items: flex-start; }
.status-wrap { gap: 8rpx; flex-shrink: 0; margin-left: 16rpx; }

@media (prefers-reduced-motion: reduce) {
  .course-cell { transition: none; }
}
