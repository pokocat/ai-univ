/* 任务页。间距/字重工具类在 app.wxss，本页只写自己的东西。 */

/* 头区进度：完成数是大号等宽数字，分母与说明退到次级 */
.prog-row { margin-top: 18rpx; }
.prog-count { gap: 10rpx; align-items: baseline; }
.prog-num { font-size: 46rpx; font-weight: 650; color: var(--ink-900); line-height: 1; }
.prog-total { font-size: var(--fs-sec); color: var(--ink-600); }

/* 列表单元：细线分隔，最后一行不留线 */
.task-cell {
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
  transition: opacity 180ms ease;
}
.task-cell:last-child { border-bottom: none; }
.task-cell:active { opacity: 0.6; }
/* 已完成：整行降权后退，但不隐藏——用户要能看见今天做了什么 */
.task-cell--done { opacity: 0.55; }

.task-row { gap: 22rpx; align-items: flex-start; }
.task-check { margin-top: 2rpx; }
.task-check--urgent { border-color: var(--danger); }
.task-check--done { border-color: var(--ok); background: var(--ok); }

.task-title { font-size: 28rpx; font-weight: 600; color: var(--ink-900); }
.task-title--done { color: var(--ink-600); text-decoration: line-through; }
.task-meta { gap: 16rpx; margin-top: 14rpx; flex-wrap: wrap; }
.meta-clock { gap: 8rpx; }

@media (prefers-reduced-motion: reduce) {
  .task-cell { transition: none; }
}
