/* 预约详情页版式。 */
.br-title { font-size: 59rpx; letter-spacing: 2rpx; }
.br-report { display: flex; align-items: center; gap: 18rpx; padding: 24rpx; }
.br-report-t { display: block; font-size: var(--fs-h4); font-weight: 700; color: var(--on-signal); }
.br-report-d { display: block; font-size: var(--fs-tiny); color: var(--on-signal-2); margin-top: 5rpx; }
.br-report-btn {
  flex-shrink: 0; display: flex; align-items: center; gap: 8rpx;
  height: 58rpx; padding: 0 24rpx; border-radius: var(--r-pill);
  background: var(--on-signal-wash); color: var(--on-signal);
  font-size: var(--fs-sec); font-weight: 700;
}
.block { display: block; }
