/* 开通成功页版式。 */
.suc-hero { padding: 28rpx 28rpx 32rpx; overflow: hidden; }
.suc-title { font-size: 70rpx; letter-spacing: 3rpx; }
.suc-class { position: relative; overflow: hidden; }
.suc-class-name { font-size: 45rpx; font-weight: 700; }
.tl-t { display: block; font-size: var(--fs-h3); font-weight: 700; color: var(--ink-900); }
.ghost-action { display: flex; align-items: center; gap: 18rpx; padding: 24rpx; }
.ga-t { display: block; font-size: var(--fs-body); font-weight: 700; color: var(--ink-900); }
.ga-d { display: block; font-size: var(--fs-tiny); color: var(--ink-600); margin-top: 5rpx; }
.block { display: block; }
