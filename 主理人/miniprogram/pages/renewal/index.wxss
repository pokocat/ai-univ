/* 续费页版式。 */
.rn-hero { padding: 28rpx; overflow: hidden; }
.rn-title { font-size: 45rpx; font-weight: 700; margin: 10rpx 0; }
.rn-expiry { display: block; font-size: 33rpx; font-weight: 700; color: var(--ink-900); margin-top: 4rpx; }
.mcard-pro {
  font-family: var(--font-mono); font-weight: 700; font-size: var(--fs-tiny);
  color: var(--on-signal); padding: 4rpx 16rpx; border-radius: 12rpx;
  background: linear-gradient(120deg, #7C3AED, #6D28D9);
}
.rn-plan {
  display: flex; align-items: center; gap: 21rpx;
  padding: 21rpx 18rpx; border-radius: var(--r-box); margin-bottom: 14rpx;
  background: var(--sunk); border: 1rpx solid var(--line);
}
.rn-plan:last-child { margin-bottom: 0; }
.rn-plan--on { border-color: var(--signal-600); background: var(--sunk-3); }
.save { display: block; margin-top: 4rpx; font-size: var(--fs-tiny); color: var(--pulse-600); }
.keep-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }
.keep-tile { text-align: center; }
.keep-ico {
  width: 73rpx; height: 73rpx; margin: 0 auto; border-radius: 21rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--sunk-3); border: 1rpx solid var(--line-brand);
}
.keep-t { display: block; margin-top: 10rpx; font-size: var(--fs-meta); font-weight: 700; color: var(--ink-900); }
.keep-d { display: block; margin-top: 4rpx; font-size: var(--fs-micro); color: var(--ink-600); }
.block { display: block; }
