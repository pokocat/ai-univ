.card--pad16 {
  padding: 16px;
}

/* --- 总营收 ------------------------------------------------------------- */
.tot {
  display: flex;
  align-items: baseline;
  gap: 11px;
  margin-top: 11px;
}

.tot__n {
  font: 700 32px/1 var(--f-mono);
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

.tot__u {
  font: 400 15px/1 var(--f-sans);
  color: var(--slate);
}

.tot__d {
  padding: 4px 9px;
  font-size: 10.5px;
}

/* 堆叠色条：各来源占比 */
.stackbar {
  display: flex;
  height: 9px;
  border-radius: 999px;
  overflow: hidden;
  margin-top: 15px;
  gap: 2px;
}

.stackbar__seg {
  height: 9px;
}

.srcs {
  display: flex;
  flex-direction: column;
  gap: 9px;
  margin-top: 14px;
}

.src {
  display: flex;
  align-items: center;
  gap: 9px;
}

.src__dot {
  width: 8px;
  height: 8px;
  border-radius: 2px;
  flex-shrink: 0;
}

.src__n {
  flex: 1;
  font: 400 11.5px/1 var(--f-sans);
  color: var(--slate);
}

.src__v {
  font: 600 11.5px/1 var(--f-mono);
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

/* --- 前后对比 ----------------------------------------------------------- */
.duo {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 11px;
}

.duo .card {
  border-radius: 15px;
  padding: 14px;
}

.kpi__v {
  display: flex;
  align-items: baseline;
  gap: 8px;
  margin-top: 10px;
}

.kpi__n {
  font: 700 22px/1 var(--f-mono);
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

.kpi__u {
  font: 400 11px/1 var(--f-sans);
  color: var(--grey);
}

.kpi__was {
  font: 400 10.5px/1 var(--f-mono);
  color: var(--green);
  margin-top: 8px;
}

/* --- 组合拳 ------------------------------------------------------------- */
.combo {
  border-radius: 16px;
  padding: 16px;
}

.combo__list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 14px;
}

.combo__row {
  display: flex;
  gap: 10px;
}

.combo__i {
  width: 14px;
  flex-shrink: 0;
  font: 600 10px/1.5 var(--f-mono);
  color: var(--purple);
}

.combo__s {
  flex: 1;
  font: 400 11.5px/1.5 var(--f-sans);
  color: #D5DBDF;
}

.combo__hr {
  margin: 15px 0 13px;
}

.combo__foot {
  font: 400 11.5px/1.55 var(--f-sans);
  color: #9BA6AE;
}

/* --- 下一轮 ------------------------------------------------------------- */
.next {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 14px 15px;
}

.next__body {
  flex: 1;
}

.next__t {
  font: 700 12.5px/1.3 var(--f-sans);
  color: var(--ink);
}

.next__b {
  font: 400 11px/1.45 var(--f-sans);
  color: var(--slate);
  margin-top: 5px;
}
