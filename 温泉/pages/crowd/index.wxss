.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mb12 { margin-bottom: 12px; }
.mb14 { margin-bottom: 14px; }
.mt13 { margin-top: 13px; }

.jump {
  display: flex;
  align-items: center;
  gap: 2px;
  font: 600 12px/1 var(--f-sans);
  color: var(--purple);
}

/* --- 漏斗 --------------------------------------------------------------- */
.funnel {
  display: flex;
  flex-direction: column;
  gap: 11px;
}

.fn__row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 6px;
}

.fn__n {
  font: 500 11.5px/1 var(--f-sans);
  color: var(--slate);
}

.fn__v {
  font: 600 12px/1 var(--f-mono);
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

/* 掉得最狠的那一层用琥珀标出来 */
.fn__n--amber,
.fn__v--amber {
  color: var(--amber);
}

/* --- 机器人日志 --------------------------------------------------------- */
.bot__head {
  display: flex;
  align-items: center;
  gap: 7px;
}

.live {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
}

.live__dot {
  width: 6px;
  height: 6px;
  border-radius: 999px;
  background: var(--green);
}

.live__t {
  font: 600 10.5px/1 var(--f-sans);
  color: var(--green);
}

.log {
  display: flex;
  flex-direction: column;
  gap: 11px;
}

.log__row {
  display: flex;
  gap: 10px;
}

.log__t {
  width: 34px;
  flex-shrink: 0;
  font: 500 10px/1.5 var(--f-mono);
  color: var(--grey);
}

.log__s {
  flex: 1;
  font: 400 11.5px/1.5 var(--f-sans);
  color: var(--slate);
}

.act__flex {
  flex: 1;
}

/* --- 扫码入口 ----------------------------------------------------------- */
.entries {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 9px;
}

.entry {
  background: var(--soft);
  border-radius: 12px;
  padding: 11px;
}

.entry__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 4px;
}

.entry__n {
  font: 600 11.5px/1.3 var(--f-sans);
  color: var(--ink);
}

.entry__v {
  font: 600 15px/1 var(--f-mono);
  color: var(--purple);
  margin-top: 8px;
  font-variant-numeric: tabular-nums;
}

.entry__v--amber {
  color: var(--amber);
}

.entry__u {
  font: 400 9.5px/1 var(--f-sans);
  color: var(--grey);
  margin-top: 5px;
}
