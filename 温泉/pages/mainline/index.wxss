.hi {
  font: 400 11px/1 var(--f-sans);
  color: var(--grey);
  margin-bottom: 5px;
}

.points {
  display: flex;
  align-items: center;
  gap: 6px;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 6px 12px;
}

.points__dot {
  width: 7px;
  height: 7px;
  border-radius: 2px;
  background: var(--purple);
}

.points__n {
  font: 600 12px/1 var(--f-mono);
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

/* --- 今天该做的一件事 --------------------------------------------------- */
.today__kicker {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-bottom: 12px;
}

.today__title {
  font: 700 19px/1.4 var(--f-sans);
  letter-spacing: -0.01em;
  color: #fff;
}

.today__body {
  font: 400 12.5px/1.55 var(--f-sans);
  color: #9BA6AE;
  margin-top: 10px;
}

.today__cta {
  display: flex;
  gap: 9px;
  margin-top: 16px;
}

.today__go {
  flex: 1;
}

/* --- 五步主线 ----------------------------------------------------------- */
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mb14 { margin-bottom: 14px; }
.mb12 { margin-bottom: 12px; }
.mt13 { margin-top: 13px; }

.sub {
  font: 400 11px/1 var(--f-sans);
  color: var(--grey);
}

.rail {
  display: flex;
  align-items: center;
  margin-bottom: 13px;
}

.rail__dot {
  width: 9px;
  height: 9px;
  border-radius: 999px;
  background: var(--edge);
  flex-shrink: 0;
}

.rail__dot--done {
  background: var(--purple);
}

/* 卡住的那一步：琥珀空心圈，比其他点大 */
.rail__dot--stuck {
  width: 13px;
  height: 13px;
  background: #fff;
  border: 3px solid var(--amber);
}

.rail__seg {
  flex: 1;
  height: 2px;
  background: var(--line);
}

.rail__seg.is-on {
  background: var(--purple);
}

.steps {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 4px;
}

.steps__name {
  font: 600 10.5px/1.3 var(--f-sans);
  color: var(--ink);
}

.steps__name--stuck { color: var(--amber); }
.steps__name--todo { color: var(--grey); }

.steps__val {
  font: 500 11px/1.3 var(--f-mono);
  color: var(--green);
  margin-top: 4px;
  font-variant-numeric: tabular-nums;
}

.steps__val--stuck { color: var(--amber); }
.steps__val--todo { color: var(--grey); }

/* --- 两个读数 ----------------------------------------------------------- */
.duo {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.stat__v {
  display: flex;
  align-items: baseline;
  margin-top: 9px;
}

.stat__num {
  font-size: 24px;
  line-height: 1;
}

.stat__foot {
  font: 400 11px/1 var(--f-sans);
  color: var(--slate);
  margin-top: 7px;
}

/* --- 常用四宫格 --------------------------------------------------------- */
.grid4 {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
}

.sc {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.sc__name {
  font: 500 10.5px/1 var(--f-sans);
  color: var(--slate);
}
