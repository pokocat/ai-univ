.nav {
  display: flex;
  align-items: center;
  gap: 12px;
}

.nav__back {
  width: 26px;
  height: 26px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -6px;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mb9 { margin-bottom: 9px; }
.mb11 { margin-bottom: 11px; }
.mb12 { margin-bottom: 12px; }
.mt12 { margin-top: 12px; }
.mt13 { margin-top: 13px; }

/* --- 三步指示器 --------------------------------------------------------- */
.steps3 {
  display: flex;
  align-items: center;
  margin-top: 10px;
}

.s3 {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
}

.s3__n {
  width: 18px;
  height: 18px;
  border-radius: 999px;
  background: var(--chip);
  color: var(--grey);
  font: 600 9px/18px var(--f-mono);
  text-align: center;
}

.s3.is-on .s3__n {
  background: var(--purple);
  color: #fff;
}

.s3__t {
  font: 500 11px/1 var(--f-sans);
  color: var(--grey);
}

.s3.is-on .s3__t {
  font-weight: 600;
  color: var(--ink);
}

.s3__seg {
  flex: 1;
  height: 1.5px;
  background: var(--line);
  margin: 0 7px;
}

.s3__seg.is-on {
  background: var(--purple);
}

/* --- 换进来的人 --------------------------------------------------------- */
.faces {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 9px;
}

/* 设计稿是 3:4。三列 ~103px 宽 → 137px 高，头像不会被裁掉头顶 */
.face {
  position: relative;
  height: 137px;
  border-radius: 11px;
  overflow: hidden;
  background: repeating-linear-gradient(135deg, #E4E8EA 0 4px, #EEF1F3 4px 8px);
}

.face__img {
  display: block;
  width: 100%;
  height: 100%;
}

.face__cap {
  position: absolute;
  left: 8px;
  bottom: 8px;
  font: 500 8.5px/1.2 var(--f-mono);
  color: #fff;
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55);
}

.face--add {
  border: 1.5px dashed #CFD6DA;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7px;
}

.face__addt {
  font: 500 9px/1 var(--f-sans);
  color: var(--grey);
}

/* --- 正在出片 ----------------------------------------------------------- */
.prog__n {
  font: 600 11.5px/1 var(--f-mono);
  color: var(--purple);
  font-variant-numeric: tabular-nums;
}

.prog__hint {
  font: 600 11.5px/1 var(--f-sans);
  color: var(--purple);
}

.clips {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
}

/* 设计稿 9:16。四列 ~76px 宽 → 135px 高 */
.clip {
  display: block;
  width: 100%;
  height: 135px;
  border-radius: 9px;
  background: repeating-linear-gradient(135deg, #E4E8EA 0 4px, #EEF1F3 4px 8px);
}

.clip--wip {
  background: var(--soft);
  border: 1px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
}

.clip__pct {
  font: 500 9px/1 var(--f-mono);
  color: var(--muted);
}

/* --- 分发渠道 ----------------------------------------------------------- */
.chans {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.chan {
  display: flex;
  align-items: center;
  gap: 10px;
}

.chan__dot {
  width: 8px;
  height: 8px;
  border-radius: 2px;
  flex-shrink: 0;
}

.chan__dot--purple { background: var(--purple); }
.chan__dot--teal { background: var(--teal); }

.chan__n {
  flex: 1;
  font: 500 12px/1 var(--f-sans);
  color: var(--ink);
}

/* --- 游客自助出片 ------------------------------------------------------- */
.selfserve {
  background: var(--tint-t);
  border: 1px solid var(--teal-edge);
  border-radius: 16px;
  padding: 14px 15px;
}

.ss__t {
  font: 700 13px/1 var(--f-sans);
  color: var(--teal-deep);
}

.ss__b {
  font: 400 11.5px/1.5 var(--f-sans);
  color: var(--teal-text);
}

.ss__b--b {
  font-weight: 700;
}

.ss__sw {
  transform: scale(0.72);
  transform-origin: right center;
  flex-shrink: 0;
}

.ss__off {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 14px 15px;
}

.ss__offbody {
  flex: 1;
}

.ss__offt {
  font: 700 12.5px/1.3 var(--f-sans);
  color: var(--grey);
}

.ss__offb {
  font: 400 11px/1.45 var(--f-sans);
  color: var(--muted);
  margin-top: 5px;
}
